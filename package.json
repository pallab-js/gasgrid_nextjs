{
  "name": "gasnext",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first City Gas Distribution (CGD) operations console: live telemetry, network graph, schematic map, alarms, work orders, consumers and reports. Next.js 16 + SQLite, runs on localhost or a private LAN.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typegen": "next typegen",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:setup": "tsx scripts/db-setup.ts",
    "db:reset": "tsx scripts/db-setup.ts --reset"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.48.0",
    "next": "16.3.7",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10",
    "eslint-config-next": "16.3.7",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
