# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# local database (auto-migrated + seeded on first run)
/data/

# logs
*.log
npm-debug.log*

# misc
.DS_Store
*.pem

# debug
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# graphify generated artifacts (regenerate with /graphify)
# Track the shareable outputs; keep machine-specific caches out of git.
graphify-out/*
!graphify-out/graph.json
!graphify-out/GRAPH_REPORT.md
!graphify-out/graph.html
!graphify-out/manifest.json
!graphify-out/cost.json
!graphify-out/.graphify_labels.json
